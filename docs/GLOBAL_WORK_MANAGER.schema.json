{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wanga-lab.example/schemas/global-work-manager.schema.json",
  "title": "WANGA Global Work Manager Task",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_id",
    "task_class",
    "objective",
    "owner",
    "dependencies",
    "status",
    "evidence_policy",
    "master_project_instructions"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "pattern": "^WGM-[A-Z0-9-]+$"
    },
    "task_class": {
      "type": "string",
      "enum": [
        "ARCHITECTURE",
        "RESEARCH",
        "MODEL_DISCOVERY",
        "MODEL_BINDING",
        "RUNTIME",
        "DRIFT_FORENSICS",
        "EVIDENCE",
        "VERIFICATION",
        "NTM_ESCALATION",
        "GOVERNANCE_INTERFACE",
        "PUBLICATION",
        "MAINTENANCE",
        "AUTOBUILD",
        "RATIONAL_LOGIC",
        "COMMERCIALIZATION_INTERFACE"
      ]
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "expected_artifacts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "QUEUED",
        "READY",
        "RUNNING",
        "COMPLETE",
        "BLOCKED",
        "CONFLICT",
        "REVIEW_REQUIRED"
      ]
    },
    "evidence_policy": {
      "type": "string",
      "enum": [
        "REQUIRED",
        "NOT_REQUIRED",
        "INHERITED"
      ]
    },
    "verification_required": {
      "type": "boolean"
    },
    "risk_level": {
      "type": "string",
      "enum": [
        "LOW",
        "MEDIUM",
        "HIGH",
        "CRITICAL"
      ]
    },
    "provenance": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "master_project_instructions": {
      "const": "docs/MASTER_PROJECT_INSTRUCTIONS_V1.md"
    }
  }
}
