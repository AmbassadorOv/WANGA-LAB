{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wanga-lab.example/schemas/interest-vote.schema.json",
  "title": "Research Interest Vote",
  "type": "object",
  "additionalProperties": false,
  "required": ["vote_id", "submitted_at", "respondent_ref", "topic_ids"],
  "properties": {
    "vote_id": {"type": "string", "pattern": "^RDV-[0-9]{4}-[0-9]{2}-[0-9]{4,}$"},
    "submitted_at": {"type": "string", "format": "date-time"},
    "respondent_ref": {"type": "string", "minLength": 1, "description": "Pseudonymous reference; do not store unnecessary personal data."},
    "topic_ids": {"type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": {"type": "string"}},
    "interest_note": {"type": "string", "maxLength": 1000},
    "region": {"type": "string", "maxLength": 100},
    "language": {"type": "string", "maxLength": 32}
  }
}
