{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wanga-lab.example/schemas/election-event.schema.json",
  "title": "International Drift Propagation Election Event",
  "type": "object",
  "additionalProperties": false,
  "required": ["event_id", "jurisdiction", "region", "event_type", "status", "source_refs", "observation_window"],
  "properties": {
    "event_id": {"type": "string", "pattern": "^ELECTION-[0-9]{4}-[A-Z0-9-]+$"},
    "jurisdiction": {"type": "string", "minLength": 1},
    "region": {"type": "string", "minLength": 1},
    "event_type": {"type": "string", "enum": ["GENERAL", "PRESIDENTIAL", "LEGISLATIVE", "EXECUTIVE", "LOCAL", "REFERENDUM", "RUNOFF", "OTHER"]},
    "status": {"type": "string", "enum": ["SCHEDULED", "ACTIVE", "COMPLETED", "POSTPONED", "CANCELLED", "UNRESOLVED"]},
    "scheduled_date": {"type": ["string", "null"], "format": "date"},
    "actual_start": {"type": ["string", "null"], "format": "date-time"},
    "actual_end": {"type": ["string", "null"], "format": "date-time"},
    "languages": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "source_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "observation_window": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baseline_start", "baseline_end", "pre_event_start", "high_resolution_start", "high_resolution_end", "post_event_end", "persistence_end"],
      "properties": {
        "baseline_start": {"type": "string", "format": "date-time"},
        "baseline_end": {"type": "string", "format": "date-time"},
        "pre_event_start": {"type": "string", "format": "date-time"},
        "high_resolution_start": {"type": "string", "format": "date-time"},
        "high_resolution_end": {"type": "string", "format": "date-time"},
        "post_event_end": {"type": "string", "format": "date-time"},
        "persistence_end": {"type": "string", "format": "date-time"}
      }
    },
    "event_phases": {"type": "array", "items": {"type": "string"}},
    "version": {"type": "integer", "minimum": 1}
  }
}