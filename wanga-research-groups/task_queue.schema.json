{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wanga-lab.example/schemas/research-group-task-queue.schema.json",
  "title": "WANGA Research Group Task Queue",
  "type": "object",
  "additionalProperties": false,
  "required": ["queue_id", "group_id", "tasks"],
  "properties": {
    "queue_id": {"type": "string"},
    "group_id": {"type": "string", "pattern": "^RG-[A-Z0-9-]+$"},
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["task_id", "objective", "status", "acceptance_checks"],
        "properties": {
          "task_id": {"type": "string"},
          "objective": {"type": "string"},
          "status": {"type": "string", "enum": ["QUEUED", "RUNNING", "COMPLETE", "BLOCKED", "REVIEW"]},
          "owner_role": {"type": "string"},
          "dependencies": {"type": "array", "items": {"type": "string"}},
          "inputs": {"type": "array", "items": {"type": "string"}},
          "expected_artifacts": {"type": "array", "items": {"type": "string"}},
          "acceptance_checks": {"type": "array", "items": {"type": "string"}},
          "risk_level": {"type": "string", "enum": ["LOW", "MEDIUM", "HIGH"]}
        }
      }
    }
  }
}
