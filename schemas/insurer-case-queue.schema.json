{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wanga-lab.example/schemas/insurer-case-queue.schema.json",
  "title": "WANGA-LAB Insurer Case Queue",
  "type": "object",
  "additionalProperties": false,
  "required": ["queue_id", "active_limit", "cases"],
  "properties": {
    "queue_id": {"type": "string"},
    "active_limit": {"type": "integer", "minimum": 0},
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["case_ref", "state"],
        "properties": {
          "case_ref": {"type": "string"},
          "state": {
            "type": "string",
            "enum": ["INTAKE","SCOPED","READY_FOR_REPLAY","QUEUED","REPLAY","VERIFY","HUMAN_GATE","REPORT","BLOCKED","CLOSED"]
          },
          "history": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  }
}
